# ─── Neon Postgres ──────────────────────────────────────────────────────────
# DATABASE_URL — пулований ендпоінт (у хості є "-pooler"). Ним працює додаток.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/lilylook?sslmode=require"

# DIRECT_URL — прямий ендпоінт (без "-pooler"). Ним працюють міграції.
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/lilylook?sslmode=require"

# ─── Магазин ────────────────────────────────────────────────────────────────
# Публічна адреса сайту (використовується в canonical/OG-тегах).
PUBLIC_SITE_URL="http://localhost:5173"

# Тільки для продакшену за зворотним проксі (хостинг, VPS з nginx).
# Без нього adapter-node бачить хост "localhost" і відхиляє відправку форм
# як міжсайтову: кошик і замовлення перестають працювати. Локально не потрібен.
# ORIGIN="https://lilylook.store"

# ─── Нова Пошта ─────────────────────────────────────────────────────────────
# Тільки довідник адрес: підказки міста й відділення в чекауті.
# Без ключа магазин працює, але адресу покупець вводить вручну.
# Ключ також вмикає реальний розрахунок вартості доставки в чекауті.
# Де взяти: кабінет НП → Налаштування → Безпека → Ключі API (безкоштовно).
NOVA_POSHTA_API_KEY=""

# ─── Telegram ───────────────────────────────────────────────────────────────
# Бот для менеджерів: замовлення з кнопками статусів у особистому чаті.
# 1. @BotFather → /newbot → токен
# 2. TELEGRAM_WEBHOOK_SECRET — спільний секрет із Telegram: він шле його
#    заголовком, і без збігу вебхук нікого не слухає. Без цієї змінної бот
#    вимкнений. Згенерувати: node -e "console.log(crypto.randomUUID())"
# 3. Зареєструвати вебхук (потрібен публічний HTTPS): npm run telegram:webhook
#    Подивитись стан: npm run telegram:webhook -- --status
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ─── Реклама Meta (Facebook, Instagram) ─────────────────────────────────────
# Події для реклами — з сервера, без пікселя в браузері (README, «Реклама Meta»).
# Без цих двох змінних нічого не шлеться. Перевірка: npm run meta:check
# ID: Events Manager → набір даних → «Налаштування» → «Ідентифікатор набору даних».
# Токен: там же → API Conversions → «Згенерувати маркер доступу». Це секрет.
META_PIXEL_ID=""
META_CAPI_TOKEN=""
# Необов'язково: підтвердження домену (Безпека бренду → Домени → «Метатег» → content).
META_DOMAIN_VERIFICATION=""
# Лише на час перевірки: події йдуть у «Тестування подій». Потім прибрати.
META_TEST_EVENT_CODE=""
