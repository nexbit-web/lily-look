// LILY LOOK — схема інтернет-магазину жіночого одягу.
//
// Гроші зберігаються цілими числами в копійках (Int), а не Decimal/Float:
// це виключає похибки округлення й серіалізується в SvelteKit без конвертацій.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Каталог ────────────────────────────────────────────────────────────────

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  /// Обкладинка категорії для вітрини /catalog. Заповнює CRM при створенні
  /// категорії; без неї плитка показує заглушку.
  imageUrl String?
  position Int     @default(0)

  // Самопосилання дозволяє робити підкатегорії ("Сукні → Вечірні")
  // без зміни схеми.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products  Product[]
  discounts DiscountCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, position])
}

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  /// Базова ціна в копійках — та, що без знижок. Знижки її не чіпають.
  price       Int
  /// Ціна до сплати після знижок, у копійках.
  ///
  /// Рахує тригер у БД (`lily_recompute_prices`), тому колонка однакова для
  /// сайту і для CRM — писати в неї вручну не треба. Знижка діє, коли
  /// finalPrice < price: саме за цією умовою працюють фільтр «Знижки»
  /// й закреслена стара ціна.
  finalPrice  Int    @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images       ProductImage[]
  variants     ProductVariant[]
  discounts    DiscountProduct[]
  attributes   ProductAttribute[]
  measurements ProductMeasurement[]

  /// Вимикач моделі в CRM: false — товару на сайті немає взагалі.
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
  @@index([isActive, finalPrice])
}

/// Заміри розмірів — те, що показує таблиця розмірів на сторінці товару.
///
/// Таблицю завела CRM, сайт із неї тільки читає: модель списана з бази
/// як є (`prisma db pull`), тож `id` тут без `@default` — його генерує
/// той, хто пише рядок. Колонки заміру необовʼязкові: у спідниці немає
/// рукава, і порожня колонка просто не малюється.
///
/// Немає жодного рядка — немає й посилання на таблицю: показувати чужі
/// заміри гірше, ніж не показувати нічого.
model ProductMeasurement {
  id        String  @id
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Розмір, до якого належать заміри — рядок із `ProductVariant.size`.
  size     String
  /// Український розмір: «44», «50–52».
  ua       String?
  chest    Int?
  sleeve   Int?
  length   Int?
  /// Порядок рядка в таблиці.
  position Int     @default(0)

  @@unique([productId, size])
  @@index([productId, position])
}

/// Характеристика товару: склад, країна виробництва, догляд, сезон — усе,
/// що CRM заводить довільними полями. Порожніх характеристик тут не буває:
/// чого немає — того немає й у списку, а сторінка малює тільки те, що є.
model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Назва в тому вигляді, в якому її побачить покупець: «Склад».
  name     String
  value    String
  /// Порядок у списку на сторінці товару.
  position Int    @default(0)

  /// Одна характеристика — один рядок: дві «Країни виробництва» в одного
  /// товару означали б помилку імпорту, а не два значення.
  @@unique([productId, name])
  @@index([productId, position])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  /// До якого кольору належить фото — рядок із `ProductVariant.color`,
  /// літера в літеру. NULL означає «фото спільне»: воно показується
  /// при будь-якому обраному кольорі (крій, тканина зблизька, бирка).
  ///
  /// Якщо для обраного кольору фото немає жодного, галерея показує все,
  /// що є, — краще зайві кадри, ніж порожнє місце.
  color String?

  @@index([productId, position])
  @@index([productId, color, position])
}

/// Конкретна одиниця товару: розмір + колір. Саме варіант має залишок і SKU,
/// саме варіант потрапляє в кошик і замовлення.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku        String  @unique
  size       String
  color      String
  colorHex   String?
  /// Базова ціна в копійках, якщо відрізняється від Product.price
  /// (напр. XXL дорожчий). NULL — беремо ціну товару.
  price      Int?
  /// Ціна варіанта після знижок. NULL, коли немає власної ціни — тоді
  /// діє Product.finalPrice. Рахує той самий тригер, що й для товару.
  finalPrice Int?
  /// Скільки одиниць саме цього розміру й кольору на складі.
  /// 0 — розмір зникає з сайту; коли нуль у всіх варіантів,
  /// товар зникає з каталогу, але сторінка лишається доступною.
  stock      Int     @default(0)
  /// Вимикач конкретного розміру/кольору в CRM.
  isActive   Boolean @default(true)
  /// Порядок, у якому варіанти показує сайт; його задає менеджер у CRM.
  /// Розміри йдуть шкалою (XS → S → M → L → XL…, далі числовий ряд
  /// 38–54), кольори — як вирішив менеджер. Нуль у всіх варіантів
  /// означає, що порядок ще не проставили: тоді сортуємо за назвою.
  position   Int     @default(0)

  cartItems CartItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([productId, isActive, stock])
  @@index([productId, position])
}

// ─── Знижки ─────────────────────────────────────────────────────────────────

/// На що поширюється правило знижки.
enum DiscountScope {
  /// Весь каталог.
  ALL
  /// Обрані категорії (таблиця DiscountCategory).
  CATEGORY
  /// Обрані товари, хоч один (таблиця DiscountProduct).
  PRODUCT
}

/// Правило знижки — єдине джерело правди про ціну.
///
/// CRM створює правило й вмикає його прапорцем `isActive`; підсумкову ціну
/// перераховує тригер у БД. Правил може бути кілька одночасно — виграє те,
/// що дає покупцеві найнижчу ціну (знижки не додаються одна до одної).
///
/// Задається або `percent`, або `amount` — не обидва (перевіряє CHECK у БД).
model Discount {
  id      String        @id @default(cuid())
  name    String
  scope   DiscountScope
  /// Відсоток знижки, 1..90.
  percent Int?
  /// Фіксована знижка в копійках.
  amount  Int?

  isActive Boolean @default(false)

  categories DiscountCategory[]
  products   DiscountProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model DiscountCategory {
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([categoryId])
}

model DiscountProduct {
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
}

// ─── Кошик ──────────────────────────────────────────────────────────────────

/// Кошик живе на сервері й ідентифікується httpOnly-кукою.
/// Ціни завжди перераховуються з БД, тому клієнт не може їх підробити.
model Cart {
  id    String     @id @default(cuid())
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ─── Замовлення ─────────────────────────────────────────────────────────────

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DeliveryMethod {
  NOVA_POSHTA_BRANCH
  NOVA_POSHTA_COURIER
  UKRPOSHTA_BRANCH
  PICKUP
}

model Order {
  id     String      @id @default(cuid())
  /// Людиночитний номер для клієнта й менеджера, напр. "LL-2K4F7B".
  number String      @unique
  status OrderStatus @default(NEW)

  customerName  String
  customerPhone String
  customerEmail String?

  deliveryMethod  DeliveryMethod
  /// Адреса зберігається текстом — накладні не створюємо, менеджеру
  /// потрібні лише назва населеного пункту й відділення.
  deliveryCity    String?
  deliveryAddress String?
  comment         String?

  /// Усі суми — в копійках, зафіксовані на момент оформлення.
  subtotal     Int
  deliveryCost Int @default(0)
  total        Int

  paymentStatus   PaymentStatus @default(UNPAID)
  /// Ідентифікатор провайдера оплати ("manual", "stripe", "liqpay"…).
  paymentProvider String        @default("manual")
  /// Ідентифікатор транзакції у провайдера.
  paymentRef      String?

  items   OrderItem[]
  events  OrderEvent[]
  /// Повідомлення про це замовлення, надіслані в Telegram.
  notices BotNotice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// Позиція замовлення — денормалізований знімок товару.
/// Якщо товар пізніше перейменують, подорожчають або видалять,
/// замовлення залишиться історично точним.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Посилання на варіант без FK: варіант може зникнути, замовлення — ні.
  variantId   String?
  sku         String
  productName String
  productSlug String
  size        String
  color       String
  imageUrl    String?

  /// Ціна за одиницю в копійках на момент замовлення.
  unitPrice Int
  quantity  Int

  @@index([orderId])
}

// ─── Телеграм-бот для менеджерів ────────────────────────────────────────────

/// Що людині дозволено робити із замовленнями в боті.
enum BotRole {
  /// Веде замовлення від «нове» до «відправлено», може скасувати.
  MANAGER
  /// Тільки доставка: бачить відправлені й позначає отримані.
  COURIER
  /// Усе те саме плюс звіти й видача доступів. Роль власника.
  ADMIN
}

/// Людина, якій видано доступ до бота.
///
/// Рядок зʼявляється не з CRM, а в мить, коли людина надіслала боту свій
/// код: тільки тоді стає відомий її telegram id. CRM створює `BotInvite`,
/// бот створює `BotUser`.
model BotUser {
  id String @id @default(cuid())

  /// Telegram user id. BigInt — вони давно вийшли за межі Int.
  /// Підробити його не можна: він приходить у підписаному вебхуці.
  telegramId BigInt  @unique
  /// Особистий чат із ботом — туди падають замовлення й кнопки.
  chatId     BigInt
  /// Імʼя з Telegram на момент привʼязки — для журналу й списку в CRM.
  name       String
  username   String?

  role     BotRole   @default(MANAGER)
  /// Вимикач доступу з CRM. Знятий прапорець діє з наступного дотику:
  /// ні кнопка, ні команда більше не спрацюють.
  isActive Boolean   @default(true)
  /// Коли людина вийшла сама (командою в боті).
  ///
  /// Відрізняє добровільний вихід від відкликання власником: після виходу
  /// можна повернутись новим кодом, після відкликання — ні. Без цієї
  /// позначки будь-хто, кого позбавили доступу, повертав би його сам.
  leftAt   DateTime?

  invite  BotInvite?
  events  OrderEvent[]
  notices BotNotice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// Одноразовий код доступу. Створює CRM, гасить бот.
///
/// Сенс саме в одноразовості: код можна спокійно передати в месенджері,
/// бо після першого використання він мертвий, а до використання не дає
/// нічого. Telegram id наперед знати не треба — людина приносить його сама.
model BotInvite {
  id String @id @default(cuid())

  /// Те, що людина надсилає боту: `/start <code>`.
  code String  @unique
  role BotRole @default(MANAGER)
  /// Кому призначено — щоб у CRM було видно, кого чекаємо.
  note String?

  /// Порожньо — код безстроковий.
  expiresAt DateTime?
  /// Заповнюється в мить використання. NULL — код ще живий.
  usedAt    DateTime?
  usedById  String?   @unique
  usedBy    BotUser?  @relation(fields: [usedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([usedAt])
}

/// Хто і коли міняв статус замовлення.
///
/// Саме звідси CRM бере історію. `Order.status` лишається актуальним
/// зрізом, щоб не збирати його щоразу з подій.
model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status  OrderStatus
  /// Хто змінив. NULL — зміна прийшла не з бота (CRM, сам сайт).
  actorId String?
  actor   BotUser?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note    String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Надіслане в Telegram повідомлення про замовлення.
///
/// Потрібне, щоб після зміни статусу переписати всі копії: замовлення
/// їде кільком менеджерам, і в решти воно інакше лишилось би з кнопками
/// від стану, якого вже немає.
model BotNotice {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  botUserId String?
  botUser   BotUser? @relation(fields: [botUserId], references: [id], onDelete: Cascade)

  chatId    BigInt
  messageId BigInt

  createdAt DateTime @default(now())

  @@unique([orderId, chatId])
  @@index([orderId])
}

/// Оброблені апдейти Telegram — щоб повтор не спрацював двічі.
///
/// Telegram перешле подію, якщо не отримав 200 вчасно, а холодний старт
/// хостингу — саме той випадок. Без цієї таблиці одне натискання могло б
/// перевести замовлення через два стани.
model BotUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}
