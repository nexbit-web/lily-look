// LILY LOOK — схема інтернет-магазину жіночого одягу.
//
// Гроші зберігаються цілими числами в копійках (Int), а не Decimal/Float:
// це виключає похибки округлення й серіалізується в SvelteKit без конвертацій.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Каталог ────────────────────────────────────────────────────────────────

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  imageUrl String?
  position Int     @default(0)

  // Самопосилання дозволяє робити підкатегорії ("Сукні → Вечірні")
  // без зміни схеми.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, position])
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  /// Базова ціна в копійках.
  price       Int
  /// Стара ціна в копійках — показується закресленою, якщо вища за price.
  compareAt   Int?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images   ProductImage[]
  variants ProductVariant[]

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId, position])
}

/// Конкретна одиниця товару: розмір + колір. Саме варіант має залишок і SKU,
/// саме варіант потрапляє в кошик і замовлення.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku      String  @unique
  size     String
  color    String
  colorHex String?
  /// Ціна в копійках, якщо відрізняється від Product.price (напр. XXL дорожчий).
  price    Int?
  stock    Int     @default(0)

  cartItems CartItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ─── Кошик ──────────────────────────────────────────────────────────────────

/// Кошик живе на сервері й ідентифікується httpOnly-кукою.
/// Ціни завжди перераховуються з БД, тому клієнт не може їх підробити.
model Cart {
  id    String     @id @default(cuid())
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ─── Замовлення ─────────────────────────────────────────────────────────────

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DeliveryMethod {
  NOVA_POSHTA_BRANCH
  NOVA_POSHTA_COURIER
  UKRPOSHTA_BRANCH
  PICKUP
}

model Order {
  id     String      @id @default(cuid())
  /// Людиночитний номер для клієнта й менеджера, напр. "LL-2K4F7B".
  number String      @unique
  status OrderStatus @default(NEW)

  customerName  String
  customerPhone String
  customerEmail String?

  deliveryMethod DeliveryMethod
  /// Адреса зберігається текстом — накладні не створюємо, менеджеру
  /// потрібні лише назва населеного пункту й відділення.
  deliveryCity    String?
  deliveryAddress String?
  comment         String?

  /// Усі суми — в копійках, зафіксовані на момент оформлення.
  subtotal     Int
  deliveryCost Int @default(0)
  total        Int

  paymentStatus   PaymentStatus @default(UNPAID)
  /// Ідентифікатор провайдера оплати ("manual", "stripe", "liqpay"…).
  paymentProvider String        @default("manual")
  /// Ідентифікатор транзакції у провайдера.
  paymentRef      String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// Позиція замовлення — денормалізований знімок товару.
/// Якщо товар пізніше перейменують, подорожчають або видалять,
/// замовлення залишиться історично точним.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Посилання на варіант без FK: варіант може зникнути, замовлення — ні.
  variantId   String?
  sku         String
  productName String
  productSlug String
  size        String
  color       String
  imageUrl    String?

  /// Ціна за одиницю в копійках на момент замовлення.
  unitPrice Int
  quantity  Int

  @@index([orderId])
}
